{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store care product",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "ingredients": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "stock", "category", "image"]
    },
    "Category": {
      "title": "Category",
      "description": "Store category",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 500 },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["new", "processing", "shipped", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "customerName", "phone", "city", "address", "items", "totalAmount", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products catalog collection"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Categories collection"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders collection"
    }
  }
}
